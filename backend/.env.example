# Backend environment (names only; see project-context/1.define/sad.md §4).
# Copy to backend/.env for local development. Never commit real values.

ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg://peers:peers@localhost:5432/peers
SESSION_SECRET=
DEMO_ACCESS_CODE=
ALLOWED_ORIGINS=http://localhost:3000
AI_SPEND_CAP_USD=20
AI_MODEL_SUGGEST=claude-sonnet-5-5
AI_MODEL_ASSIST=claude-sonnet-5-5
AAMAD_TARGET_RUNTIME=crewai
# Reasoning effort for both crews (SAD Model and Context Strategy). No temperature exists.
AI_EFFORT=low
# Session cookie `Secure` flag. Keep true; set false only for plain-http local testing in
# browsers that do not treat localhost as secure (Safari).
COOKIE_SECURE=true
# Where per-request model traces (ids and counts only) are appended as JSON lines.
TRACE_LOG_DIR=../project-context/2.build/logs
